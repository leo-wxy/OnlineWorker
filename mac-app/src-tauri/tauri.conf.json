{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OnlineWorker",
  "version": "1.11.0",
  "identifier": "com.wxy.onlineworker-app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "OnlineWorker",
        "width": 960,
        "height": 700,
        "minWidth": 800,
        "minHeight": 500,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' ipc: https://api.tauri.app"
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "resources": [
      "provider-plugins",
      "hook-relays",
      "icons/tray-template.png",
      "icons/tray-template@2x.png",
      "notification-plugins"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "externalBin": [
      "binaries/onlineworker-bot",
      "binaries/ccusage"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlERDZFNzRENENEOTNDMTgKUldRWVBObE1UZWZXblVhMStsRldRT2E1eDBoWHdlTDJRUm5BY25OTVF6enNiU2ZlSlJhY0xGZTAK",
      "endpoints": [
        "https://github.com/leo-wxy/OnlineWorker/releases/latest/download/latest.json"
      ]
    }
  }
}
